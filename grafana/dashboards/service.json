{
  "uid": "epl-service",
  "title": "Служебный: загрузки, проверки качества, модели",
  "tags": [
    "epl",
    "служебный"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Основной дашборд",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/epl-overview",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Журнал загрузок данных",
      "description": "Каждая строка: один запуск сборщика. Повторный запуск на тех же данных даёт нули в «Вставлено» и «Обновлено» (идемпотентность).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "epl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "epl-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS \"№\", started_at AS \"Начало\", source AS \"Источник\", status AS \"Статус\", rows_fetched AS \"Получено\", rows_inserted AS \"Вставлено\", rows_updated AS \"Обновлено\", rows_skipped AS \"Без изменений\", rows_rejected AS \"Отклонено\", left(error, 80) AS \"Ошибка\" FROM ingest_runs ORDER BY id DESC LIMIT 15"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Начало"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Статус"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "#2a78d6",
                        "text": "success"
                      },
                      "partial": {
                        "color": "#eb6834",
                        "text": "partial"
                      },
                      "failed": {
                        "color": "#eb6834",
                        "text": "failed"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Проверки качества данных: последний результат",
      "description": "error: провал блокирует обновление данных; warn: предупреждение. Часть предупреждений ожидаема: матчи без зрителей в 2019–2020 и расхождения времени начала между источниками.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "epl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "epl-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (table_name, check_name) table_name AS \"Таблица\", check_name AS \"Проверка\", severity AS \"Важность\", CASE WHEN passed THEN 'пройдена' ELSE 'не пройдена' END AS \"Результат\", checked_at AS \"Когда\" FROM dq_checks ORDER BY table_name, check_name, checked_at DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Когда"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Результат"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "пройдена": {
                        "color": "#2a78d6",
                        "text": "пройдена"
                      },
                      "не пройдена": {
                        "color": "#eb6834",
                        "text": "не пройдена"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Версии моделей",
      "description": "production: рабочая версия, по ней считаются прогнозы; archived: прежние версии.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "epl-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "epl-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS \"№\", model_name AS \"Модель\", status AS \"Статус\", trained_at AS \"Обучена\", round((metrics->'cv'->>'mae')::numeric) AS \"MAE (проверка)\", round((metrics->'test'->>'mae')::numeric) AS \"MAE (тест)\", artifact_path AS \"Файл\" FROM model_versions ORDER BY id DESC LIMIT 10"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Обучена"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Журнал экспериментов",
      "description": "Каждый запуск обучения записывает конфигурацию, версию данных (хеш) и метрики. cv: скользящая проверка, test: тест 2022/23.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "epl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "epl-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS \"№\", created_at AS \"Время\", kind AS \"Вид\", model_name AS \"Модель\", round((metrics->>'mae')::numeric) AS \"MAE\", round((metrics->>'rmse')::numeric) AS \"RMSE\", left(data_hash, 8) AS \"Хеш данных\", seed AS \"Зерно\" FROM experiments WHERE kind IN ('cv', 'test') ORDER BY id DESC LIMIT 16"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Время"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      }
    }
  ]
}
